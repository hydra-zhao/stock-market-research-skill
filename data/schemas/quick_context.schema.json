{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quick_context.schema.json",
  "title": "FINAL-001 Quick Review Canonical Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "generated_at", "data_date",
    "source_snapshot", "market", "eco", "holdings", "leaders", "actions",
    "stages", "hooks", "sections", "relay_analysis", "mainline_analysis",
    "tomorrow_plan"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "quick_context"},
    "generated_at": {"type": "string", "minLength": 19},
    "data_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "deliverable"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deliverable": {"const": false}
      }
    },
    "market": {
      "type": "object", "additionalProperties": false,
      "required": ["limit_up", "limit_down", "bomb", "max_ladder", "breadth_up", "breadth_down", "turnover", "index_close", "index_change_pct"],
      "properties": {
        "limit_up": {"type": "integer", "minimum": 0},
        "limit_down": {"type": "integer", "minimum": 0},
        "bomb": {"type": "integer", "minimum": 0},
        "max_ladder": {"type": "integer", "minimum": 0},
        "breadth_up": {"type": ["integer", "null"], "minimum": 0},
        "breadth_down": {"type": ["integer", "null"], "minimum": 0},
        "turnover": {"type": ["number", "null"], "minimum": 0},
        "index_close": {"type": ["number", "null"]},
        "index_change_pct": {"type": ["number", "null"]},
        "zt_ratio": {"type": ["number", "null"], "minimum": 0},
        "dt_ratio": {"type": ["number", "null"], "minimum": 0},
        "vol_ratio": {"type": ["number", "null"], "minimum": 0},
        "bomb_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "seal_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "seal10": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "seal20": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "premium_avg": {"type": ["number", "null"]},
        "promo_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "dod_pct": {"type": ["number", "null"]},
        "vol_price": {"type": ["string", "null"]},
        "ma360": {"type": ["number", "null"]},
        "ma250": {"type": ["number", "null"]},
        "bull_bear": {"type": "string", "minLength": 1},
        "index_status": {"type": "string", "minLength": 1},
        "zt_mean": {"type": ["number", "null"], "minimum": 0},
        "dt_mean": {"type": ["number", "null"], "minimum": 0},
        "amt_mean": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "eco": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "label", "relay_allowed", "verdicts"],
      "properties": {
        "state": {"enum": ["main_rise", "divergence", "index", "hesitation", "ice", "retreat", "panic", "mixed", "intraday", "unknown"]},
        "label": {"type": "string", "minLength": 1},
        "relay_allowed": {"type": "boolean"},
        "verdicts": {
          "type": "object", "additionalProperties": false,
          "required": ["tuishen", "niepan", "yangjia", "jianguqiyi"],
          "properties": {
            "tuishen": {"type": "string"}, "niepan": {"type": "string"},
            "yangjia": {"type": "string"}, "jianguqiyi": {"type": "string"}
          }
        }
      }
    },
    "holdings": {"type": "array", "items": {"$ref": "#/$defs/holding"}},
    "leaders": {"type": "array", "items": {"$ref": "#/$defs/leader"}},
    "actions": {
      "type": "object", "additionalProperties": false,
      "required": ["ultra_relay", "swing", "existing_longterm"],
      "properties": {
        "ultra_relay": {"$ref": "#/$defs/action"},
        "swing": {"$ref": "#/$defs/action"},
        "existing_longterm": {"$ref": "#/$defs/action"}
      }
    },
    "stages": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stage"}},
    "hooks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stage"}},
    "relay_analysis": {"$ref": "#/$defs/relay_analysis"},
    "mainline_analysis": {"$ref": "#/$defs/mainline_analysis"},
    "tomorrow_plan": {"$ref": "#/$defs/tomorrow_plan"},
    "sections": {
      "type": "object", "additionalProperties": false,
      "required": ["futures", "futures_facts", "national_etf", "ladder", "broken_boards",
                   "broken_boards_unverified", "first_board", "swing", "us_etf",
                   "table_parse"],
      "properties": {
        "futures": {"type": "string"},
        "futures_facts": {"$ref": "#/$defs/futures_facts"},
        "national_etf": {"type": "string"},
        "ladder": {"type": "array", "items": {"type": "object"}},
        "broken_boards": {"type": "array", "items": {"type": "object"}},
        "broken_boards_unverified": {"type": "array", "items": {"type": "object"}},
        "first_board": {"type": "string"}, "swing": {"type": "string"},
        "swing_summary": {"$ref": "#/$defs/swing_summary"},
        "us_etf": {"type": "string"},
        "table_parse": {"$ref": "#/$defs/table_parse"}
      }
    }
  },
  "$defs": {
    "relay_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["max_ladder", "previous_top", "advancement_rate", "prior_limit_premium",
                   "broken_count", "big_loss_count", "big_loss_threshold_pct",
                   "high_board_survival", "state", "reasons", "interpretation"],
      "properties": {
        "max_ladder": {"type": ["integer", "null"], "minimum": 0},
        "previous_top": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "name", "previous_boards", "current_change_pct", "status"],
          "properties": {
            "code": {"type": ["string", "null"]}, "name": {"type": ["string", "null"]},
            "previous_boards": {"type": ["integer", "null"], "minimum": 0},
            "current_change_pct": {"type": ["number", "null"]},
            "status": {"type": ["string", "null"]}
          }
        },
        "advancement_rate": {"type": ["number", "null"]},
        "prior_limit_premium": {"type": ["number", "null"]},
        "broken_count": {"type": ["integer", "null"], "minimum": 0},
        "big_loss_count": {"type": ["integer", "null"], "minimum": 0},
        "big_loss_threshold_pct": {"type": "number"},
        "high_board_survival": {
          "type": "object", "additionalProperties": false,
          "required": ["previous_high_count", "survived_count"],
          "properties": {"previous_high_count": {"type": ["integer", "null"], "minimum": 0},
                         "survived_count": {"type": ["integer", "null"], "minimum": 0}}
        },
        "state": {"enum": ["improving", "weak_repair", "neutral", "deteriorating", "collapse", "unverified"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "mainline_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["themes", "confirmed_mainline", "summary"],
      "properties": {
        "themes": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/mainline_theme"}},
        "confirmed_mainline": {"type": ["string", "null"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "mainline_theme": {
      "type": "object", "additionalProperties": false,
      "required": ["theme", "first_board_count", "ladder_count", "total_limit_count",
                   "has_2plus_board", "fund_top10", "pass_count", "required", "status", "reasons"],
      "properties": {
        "theme": {"type": "string", "minLength": 1},
        "first_board_count": {"type": ["integer", "null"], "minimum": 0},
        "ladder_count": {"type": ["integer", "null"], "minimum": 0},
        "total_limit_count": {"type": ["integer", "null"], "minimum": 0},
        "has_2plus_board": {"type": ["boolean", "null"]},
        "fund_top10": {"type": ["boolean", "null"]},
        "pass_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "required": {"const": 2},
        "status": {"enum": ["confirmed", "candidate", "unconfirmed", "unverified"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tomorrow_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["can_trade_if", "stay_out_if", "watch_focus", "holding_focus"],
      "properties": {
        "can_trade_if": {"type": "array", "items": {"type": "string"}},
        "stay_out_if": {"type": "array", "items": {"type": "string"}},
        "watch_focus": {"type": "array", "items": {"type": "string"}},
        "holding_focus": {"type": "array", "items": {"type": "string"}}
      }
    },
    "swing_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stratification_line", "total", "tiers", "candidates"],
      "properties": {
        "stratification_line": {"type": "string", "minLength": 1},
        "total": {"type": "integer", "minimum": 0},
        "tiers": {
          "type": "object", "additionalProperties": {"type": "integer", "minimum": 0},
          "required": ["clean", "note", "down", "out", "unverified"]
        },
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/swing_candidate"}}
      }
    },
    "swing_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "tier", "tier_label", "eligible"],
      "properties": {
        "code": {"type": "string", "pattern": "^\\d{6}$"},
        "name": {"type": "string", "minLength": 1},
        "tier": {"enum": ["clean", "note", "down", "red", "unverified"]},
        "tier_label": {"type": "string", "minLength": 1},
        "eligible": {"type": "boolean"}
      }
    },
    "table_parse": {
      "type": "object", "additionalProperties": false,
      "required": ["parsed", "malformed_counts", "malformed"],
      "properties": {
        "parsed": {"type": "object", "additionalProperties": {"type": "integer"}},
        "malformed_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "malformed": {"type": "array", "items": {"$ref": "#/$defs/malformed_row"}}
      }
    },
    "malformed_row": {
      "type": "object", "additionalProperties": false,
      "required": ["section", "raw", "cells", "header_cells", "reason"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "raw": {"type": "string", "minLength": 1},
        "cells": {"type": "integer"},
        "header_cells": {"type": "integer"},
        "reason": {"enum": ["column_count_mismatch", "code_or_name_unparsable"]}
      }
    },
    "futures_facts": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "as_of", "citic_net_position", "citic_net_short",
                   "citic_long_change", "citic_short_change", "citic_net_change",
                   "top15_net_change", "top15_long_change", "top15_short_change",
                   "unverified_fields"],
      "properties": {
        "label": {"type": ["string", "null"]},
        "as_of": {"type": ["string", "null"]},
        "citic_net_position": {"type": ["integer", "null"]},
        "citic_net_short": {"type": ["integer", "null"]},
        "citic_long_change": {"type": ["integer", "null"]},
        "citic_short_change": {"type": ["integer", "null"]},
        "citic_net_change": {"type": ["integer", "null"]},
        "top15_net_change": {"type": ["integer", "null"]},
        "top15_long_change": {"type": ["integer", "null"]},
        "top15_short_change": {"type": ["integer", "null"]},
        "unverified_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_id", "status", "source_time", "temporal_valid", "error",
                   "source_path", "source_sha256"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "reused", "preliminary", "degraded", "unverified", "failed", "skipped", "not_applicable",
                            "incomplete", "suspicious", "repaired", "failed_to_repair", "legacy_unverified"]},
        "source_time": {"type": ["string", "null"]},
        "source_path": {"type": ["string", "null"]},
        "source_sha256": {"type": ["string", "null"]},
        "temporal_valid": {"type": "boolean"},
        "error": {
          "type": ["object", "null"],
          "properties": {"type": {"type": "string"}, "message": {"type": "string"}, "traceback_path": {"type": ["string", "null"]}},
          "required": ["type", "message", "traceback_path"], "additionalProperties": false
        }
      }
    },
    "holding": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "track", "cost", "status", "source"],
      "properties": {
        "code": {"type": "string", "pattern": "^\\d{6}$"}, "name": {"type": "string", "minLength": 1},
        "track": {"type": "string"}, "cost": {"type": "string"}, "status": {"type": "string"}, "source": {"type": "string"},
        "quote": {"$ref": "#/$defs/holding_quote"}
      }
    },
    "holding_quote": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["status", "date", "close", "change_pct", "volume", "turnover", "reason"],
      "properties": {
        "status": {"enum": ["verified", "unverified"]},
        "date": {"type": ["string", "null"]},
        "close": {"type": ["number", "null"], "minimum": 0},
        "change_pct": {"type": ["number", "null"]},
        "volume": {"type": ["number", "null"], "minimum": 0},
        "turnover": {"type": ["number", "null"], "minimum": 0},
        "reason": {"type": ["string", "null"]}
      }
    },
    "leader": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "code", "name", "theme", "boards", "boards_as_of", "current_status", "current_change_pct", "source"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{8}$"}, "code": {"type": "string", "pattern": "^\\d{6}$"},
        "name": {"type": "string"}, "theme": {"type": "string"}, "boards": {"type": "integer", "minimum": 0},
        "boards_as_of": {"type": ["string", "null"]}, "current_status": {"type": "string"},
        "current_change_pct": {"type": ["number", "null"]}, "source": {"type": "string"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "max_new_position_pct", "note"],
      "properties": {
        "allowed": {"type": "boolean"}, "max_new_position_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "note": {"type": "string"}
      }
    }
  }
}
